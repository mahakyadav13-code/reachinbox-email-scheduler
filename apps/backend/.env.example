# Database
DATABASE_URL=postgresql://reachinbox:reachinbox_dev_password@localhost:5432/reachinbox_scheduler

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Authentication
SESSION_SECRET=your_session_secret_min_32_chars_random_string
JWT_SECRET=your_jwt_secret_min_32_chars_random_string

# Optional: open /admin/queues with ?token=... instead of a logged-in session.
# Leave blank to require an authenticated session (recommended).
QUEUE_DASHBOARD_TOKEN=

# Ethereal Email (SMTP)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your_ethereal_username
ETHEREAL_PASS=your_ethereal_password

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Worker Configuration
WORKER_CONCURRENCY=5

# Rate Limiting (emails per hour per sender)
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Delay Configuration (seconds between emails)
MIN_DELAY_BETWEEN_EMAILS_SECONDS=2

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Node Environment
# Set to true to log every SQL query (verbose)
LOG_SQL=false

NODE_ENV=development

# Server Port
PORT=5000
